{
  "name": "agroconnect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "node seed/index.js",
    "seed:cleanup": "node seed/cleanup.js",
    "seed:fixtures": "node seed/test-fixtures.js",
    "seed:fixtures:reset": "node seed/test-fixtures.js --reset",
    "test": "node src/utils/validation.test.js && node --test tests/*.test.js tests/unit/*.test.mjs && node --test tests/db/*.test.mjs",
    "test:rls": "node tests/rls-anon-probe.mjs",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:e2e": "playwright test",
    "test:staging": "node --test --test-concurrency=1 tests/e2e/staging-anon.test.mjs tests/e2e/staging-api.test.mjs tests/e2e/staging-workflows.test.mjs tests/e2e/staging-media.test.mjs tests/e2e/staging-catchup.test.mjs tests/e2e/staging-auth.test.mjs tests/e2e/staging-video-push.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/push-notifications": "8.1.2",
    "@daily-co/daily-js": "0.93.0",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "^2.112.0",
    "lottie-react": "^2.4.1",
    "material-symbols": "0.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "1.64.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
